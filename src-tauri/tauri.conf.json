{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Evelopment Games Designer",
  "version": "0.23.2",
  "identifier": "io.github.evelynnsrepos.egd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Eve.Lopment Games Designer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "publisher": "Evelopment Games",
    "copyright": "© 2026 Evelopment Games. GPL-3.0",
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
