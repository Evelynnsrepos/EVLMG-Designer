{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Evelopment Games Designer",
  "version": "0.35.0-2",
  "identifier": "io.github.evelynnsrepos.egd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Eve.Lopment Games Designer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https: wss:",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval' 'unsafe-inline'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https: wss: ws://localhost:5173 http://localhost:5173",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$APPDATA/**", "$APPLOCALDATA/**", "$TEMP/**", "$RESOURCE/**"]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "PASTE_THE_PUBLIC_UPDATER_KEY_HERE",
      "endpoints": ["https://github.com/Evelynnsrepos/EVLMG-Designer/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "publisher": "Evelopment Games",
    "copyright": "© 2026 Evelopment Games. GPL-3.0",
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
